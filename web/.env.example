# Nothing here is required: the defaults below are what the app runs with.

# mainnet (default) or testnet: picks the node, the prover, the Gamecoin faucet and the admin below
# VITE_MIDEN_NETWORK=testnet

# Miden node: devnet | testnet | localhost | https://your-rpc-url (the network's own by default)
# VITE_MIDEN_RPC_URL=https://rpc.cedar.miden.io

# Prover: devnet | testnet | local | https://your-prover-url (the network's own by default)
# VITE_MIDEN_PROVER=https://tx-prover.cedar.miden.io

# The Gamecoin faucet (also in ../gamecoin.json) and the stake of one shot, in base units (6 decimals).
# VITE_GC_FAUCET=0xe1f2c48d5bfa8d5173dfcfdc8ac977
# VITE_GC_STAKE=1000000

# Fee faucet for a custom node; the testnet one is the default.
# VITE_MIDEN_FAUCET_URL=https://faucet-api.testnet.miden.io
